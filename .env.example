# Penfield Import - Environment Variables
# Export these variables in the shell that launches the CLI. The CLI does not read .env files.

# --- Authentication (choose one) ---

# Penfield API key (alternative to OAuth --login flow)
# Format: tm_<tenant>_ak_<key>
# export PENFIELD_API_KEY=tm_your_tenant_ak_your_key

# --- LLM Summarization (optional, for --llm mode) ---

# API key for OpenAI-compatible LLM API (required with --llm)
# export LLM_API_KEY=sk-your-openai-or-openrouter-key

# --- Penfield API (optional overrides) ---

# Base URL for Penfield API (default: https://api.penfield.app)
# export PENFIELD_BASE_URL=https://api.penfield.app

# For internal dev, set the origin before login or API-key exchange.
# export PENFIELD_BASE_URL=https://api-dev.penfield.app
