# Penfield Import - Environment Variables
# Copy this file to .env and fill in your values.

# --- Authentication (choose one) ---

# Penfield API key (alternative to OAuth --login flow)
# Format: tm_<tenant>_ak_<key>
# PENFIELD_API_KEY=tm_your_tenant_ak_your_key

# --- LLM Summarization (optional, for --llm mode) ---

# API key for OpenAI-compatible LLM API (required with --llm)
# LLM_API_KEY=sk-your-openai-or-openrouter-key

# --- Penfield API (optional overrides) ---

# Base URL for Penfield API (default: https://api.penfield.app)
# PENFIELD_BASE_URL=https://api.penfield.app
